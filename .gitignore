node_modules/
env
.env
.env.*
.DS_Store
npm-debug.log
*.local

# Saída local de scripts/visual/renderPreview.js (screenshots + HTML de
# preview) — não é artefato versionado, ver plano de migração de dossiê.
/.scratch/

# Telemetria interna de compilação (src/core/telemetria.js) — Cano 4 fase 1,
# dado operacional local, não artefato versionado.
/logs/

# Saída local de scripts/compile-batch.js (npm run compile:batch) — XML
# compilado a partir dos manifestos de manifests/, não artefato versionado
# (mesmo critério de /.scratch/ acima).
/dist/

# Gerados pelo stage "build-info" do Dockerfile em build time — nunca devem
# ser commitados (ver src/services/buildInfo.js)
/GIT_SHA
/GIT_DATE
/BUILD_TIME

# Vendorizado a partir de node_modules/ em todo `npm install` (postinstall,
# ver scripts/vendorAssets.js) — reproduzido automaticamente sempre, nunca
# precisa ficar commitado nem sincronizado manualmente.
/public/vendor/

# Vendorizado a partir de Power-up/diff_patch_engine.cpp (pasta irmã, fora
# do contexto de build do Docker do agent) via `npm run vendor:power-up`
# (ver agent/scripts/vendorPowerUp.js) — mesma lógica do /public/vendor/
# acima: sempre reproduzido a partir da fonte única de verdade, nunca
# commitado nem sincronizado manualmente.
/agent/native/