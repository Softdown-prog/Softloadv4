<%- include('../partials/header', {pageTitle:'Histórico de arquivos | Softload',pageDescription:'Baixe templates e projetos de versões anteriores da Softload.',pageNoindex:true}) %>
<main class="container-xl" style="max-width:1040px;padding-top:112px;padding-bottom:78px">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div><p class="text-info fw-bold small text-uppercase mb-1">Softload · Seus projetos anteriores</p>
      <h1 class="text-white fw-bold">Histórico de templates</h1>
      <p class="text-secondary mb-0">Consulte até 30 registros recentes de compilações associadas à sua conta.</p></div>
    <a class="btn btn-outline-secondary" href="/dashboard">Voltar ao início</a>
  </div>
  <section class="border rounded-4 p-4 p-md-5 mb-4" style="background:#111d30;border-color:#334155!important">
    <% if (!arquivos.length) { %>
      <h2 class="text-white h5">Nenhum template anterior encontrado</h2>
      <p class="text-secondary">Seu histórico antigo não foi apagado por esta migração. Aqui aparecem apenas arquivos com download vinculado ao seu usuário.</p>
    <% } else { %>
      <h2 class="text-white h5 mb-3">Downloads anteriores</h2>
      <div class="table-responsive">
        <table class="table table-dark table-borderless align-middle">
          <thead><tr><th scope="col">Projeto</th><th scope="col">Criado</th><th scope="col">Tamanho</th><th scope="col">Ação</th></tr></thead>
          <tbody>
          <% arquivos.forEach(function(item) { %>
            <tr>
              <td class="text-break"><strong><%= item.nome %></strong><div class="small text-secondary"><%= item.arquivo %></div></td>
              <td><%= item.criadoEm %></td>
              <td><%= (item.tamanhoBytes / 1048576).toFixed(2) %> MB</td>
              <td><a class="btn btn-outline-info btn-sm" href="/dashboard/compilacao/<%= encodeURIComponent(item.id) %>/download" aria-label="Baixar <%= item.nome %>">Baixar ZIP</a></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
  <p class="text-secondary">Os arquivos desta lista permanecem no armazenamento legado e não estão sujeitos à rotina de exclusão dos novos arquivos Essencial. Você também pode acessar a <a href="/dashboard/arquivos">nova área de arquivos</a> quando estiver disponível.</p>
</main>
<%- include('../partials/footer-blogger') %>
