<%- include('../partials/header', {pageTitle:'Administração | Softload Blogger',pageDescription:'Área restrita de monitoramento da Softload.',pageNoindex:true}) %>
<style>
.sl-admin {max-width:1160px;margin:0 auto;padding:112px 16px 80px;color:#e2e8f0}
.sl-admin__eyebrow {font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:#7dd3fc;font-weight:700}
.sl-admin__nav {display:flex;gap:.6rem;flex-wrap:wrap;margin:1.5rem 0 2rem}
.sl-admin__nav a {padding:.55rem .9rem;border:1px solid #334155;border-radius:12px;text-decoration:none;color:#cbd5e1}
.sl-admin__nav a[aria-current=page] {color:#fff;background:#155e75;border-color:#0e7490}
.sl-admin__card {border:1px solid #344861;background:#142236;border-radius:16px;padding:1.25rem;height:100%}
.sl-admin__card strong {display:block;font-size:clamp(1.35rem,3vw,2.1rem);color:#f8fafc;margin-top:.35rem}
.sl-admin__table {border:1px solid #344861;border-radius:16px;overflow:hidden;background:#142236}
.sl-admin__table table {margin-bottom:0}
.sl-admin__table th,.sl-admin__table td {padding:.8rem 1rem;vertical-align:middle}
.sl-admin__hint {color:#b9c5d5;font-size:.9rem;line-height:1.6}
.sl-admin a:focus-visible {outline:3px solid #7dd3fc;outline-offset:2px}
</style>
<main class="sl-admin" data-admin-section="<%= adminSection %>">
  <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
    <div>
      <p class="sl-admin__eyebrow mb-2">Área restrita · Softload Blogger</p>
      <h1 class="fw-bold text-white mb-2">Administração</h1>
      <p class="sl-admin__hint mb-0">Informações do sistema e contas cadastradas.</p>
    </div>
    <a href="/dashboard" class="btn btn-outline-info">Voltar ao Blogger</a>
  </div>
  <nav class="sl-admin__nav" aria-label="Seções da administração">
    <a href="/eu" <%= adminSection === 'inicio' ? 'aria-current=page' : '' %>>Visão geral</a>
    <a href="/eu/usuarios" <%= adminSection === 'usuarios' ? 'aria-current=page' : '' %>>Usuários</a>
  </nav>

  <% if (adminSection === 'inicio') { %>
    <section aria-labelledby="resumo-titulo">
      <h2 id="resumo-titulo" class="h4 fw-bold mb-3">Resumo de operação</h2>
      <div class="row g-3 mb-4">
        <% const cards = [['totalUsuarios','Contas cadastradas'],['totalPremium','Contas marcadas como ativas'],['totalFree','Contas não ativas'],['compilacoesTotal','Compilações registradas'],['storageTotal','Armazenamento histórico (MB)'],['expirando7dias','Planos expirando em 7 dias']]; %>
        <% cards.forEach(function(card) { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="sl-admin__card"><span class="sl-admin__hint"><%= card[1] %></span><strong data-kpi="<%= card[0] %>">—</strong></div>
          </div>
        <% }); %>
      </div>
      <p id="admin-status" class="sl-admin__hint" role="status" aria-live="polite">Consultando indicadores…</p>
    </section>
    <section aria-labelledby="acoes-titulo" class="mt-4">
      <h2 id="acoes-titulo" class="h5 fw-bold">Acompanhamento</h2>
      <div class="sl-admin__card">
        <p class="sl-admin__hint mb-2">As contagens e métricas acima vêm das APIs administrativas protegidas. O número de contas ativas não equivale a pagamentos recebidos.</p>
        <a href="/eu/usuarios" class="btn btn-outline-info me-2">Consultar usuários</a>
      </div>
    </section>
  <% } else if (adminSection === 'usuarios') { %>
    <section aria-labelledby="usuarios-titulo">
      <h2 id="usuarios-titulo" class="h4 fw-bold">Contas cadastradas</h2>
      <p class="sl-admin__hint">Consulta paginada de até 50 registros por vez. Não altera assinaturas ou dados de usuários.</p>
      <p id="admin-status" class="sl-admin__hint" role="status" aria-live="polite">Carregando contas…</p>
      <div class="table-responsive sl-admin__table">
        <table class="table table-dark table-hover" aria-label="Contas cadastradas">
          <thead><tr><th>E-mail</th><th>Nome</th><th>Plano registrado</th><th>Situação</th><th>Compilações</th><th>Armazenamento (MB)</th></tr></thead>
          <tbody id="admin-usuarios"><tr><td colspan="6">Consultando dados…</td></tr></tbody>
        </table>
      </div>
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-3" aria-label="Navegação da lista de contas">
        <span id="admin-usuarios-page" class="sl-admin__hint" aria-live="polite">Página 1</span>
        <div class="d-flex gap-2">
          <button type="button" id="admin-usuarios-prev" class="btn btn-outline-secondary btn-sm" disabled>Anterior</button>
          <button type="button" id="admin-usuarios-next" class="btn btn-outline-info btn-sm" disabled>Próxima</button>
        </div>
      </div>
    </section>
  <% } %>
</main>
<script src="/js/admin-simples.js?v=<%= gitSha %>" defer></script>
<%- include('../partials/footer-blogger') %>
