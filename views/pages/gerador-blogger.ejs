<%- include('../partials/header', {pageTitle:'Criador de Templates Blogger | Softload',pageDescription:'Gere e personalize seu template XML Blogger sem programar.',pageNoindex:!guestMode,pageCanonical:guestMode?'/criar':null}) %>
<style>
.sl-generator{max-width:1240px;margin:0 auto;padding:100px 16px 64px;color:var(--sl-text-300)}
.sl-generator .panel{background:#111c31;border:1px solid #31425d;border-radius:16px;padding:24px}
.sl-generator .eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#38bdf8;font-size:.72rem;font-weight:750}
.sl-generator label{font-weight:650;font-size:.875rem;margin-bottom:6px;color:#e2e8f0}
.sl-generator select,.sl-generator input{background:#081322!important;border:1px solid #415673!important;color:#e2e8f0!important}
.sl-generator select:focus,.sl-generator input:focus{border-color:#38bdf8!important;box-shadow:0 0 0 2px #0ea5e944!important}
.sl-generator .hint{color:#94a3b8;font-size:.83rem}
.sl-generator .fake-blog{background:#f8fafc;color:#1e293b;border-radius:13px;overflow:hidden;border:1px solid #334155}
.sl-generator .fake-header{background:#0f172a;color:white;padding:18px 20px;border-bottom:4px solid #0ea5e9}
.sl-generator .fake-nav{background:#e2e8f0;color:#475569;padding:9px 20px;font-size:.78rem}
.sl-generator .fake-body{display:grid;grid-template-columns:minmax(0,2fr) minmax(130px,1fr);gap:14px;padding:14px}
.sl-generator .fake-body.no-sidebar{grid-template-columns:1fr}
.sl-generator .fake-body.sidebar-left{grid-template-columns:minmax(130px,1fr) minmax(0,2fr)}
.sl-generator .fake-body.sidebar-left .fake-aside{order:-1}
.sl-generator .fake-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.sl-generator .fake-card{background:white;border:1px solid #cbd5e1;border-radius:7px;overflow:hidden;min-width:0}
.sl-generator .fake-thumb{height:38px;background:linear-gradient(135deg,#bae6fd,#dbeafe)}
.sl-generator .fake-title{font-size:.66rem;font-weight:700;padding:7px}
.sl-generator .fake-aside{background:white;border:1px solid #cbd5e1;border-radius:7px;padding:10px;font-size:.7rem}
.sl-generator .fake-footer{background:#0f172a;padding:13px 20px;color:#e2e8f0;font-size:.7rem}
.sl-generator #form-message{min-height:22px}
@media(max-width:1024px){.sl-generator .fake-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.sl-generator .panel{padding:17px}.sl-generator .fake-body,.sl-generator .fake-body.sidebar-left{grid-template-columns:1fr}.sl-generator .fake-grid{grid-template-columns:1fr}.sl-generator .fake-aside{order:2!important}}
</style>
<main class="sl-generator">
  <div class="mb-4 d-flex justify-content-between align-items-start gap-2 flex-wrap">
    <div>
      <p class="eyebrow mb-1">Softload Blogger · editor visual</p>
      <h1 class="fw-bolder mb-2 text-white">Criador de templates Blogger</h1>
      <p class="hint mb-0">Comece do zero ou escolha um dos <%= nichos.length %> nichos e personalize. Gere um XML real e baixe sem API de IA.</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" href="<%= guestMode ? '/' : '/dashboard' %>"><%= guestMode ? 'Página inicial' : 'Voltar ao painel' %></a>
  </div>
  <div class="row g-3">
    <section class="col-12 col-xl-5" aria-label="Configurar template">
      <div class="panel">
        <h2 class="h5 fw-bold text-white mb-3">1. Monte seu template</h2>
        <form id="generator-form" method="post" action="<%= downloadPath %>" autocomplete="off">
          <% if (guestMode) { %><input type="hidden" name="guestToken" value="<%= guestToken %>"/><% } %>
          <fieldset class="mb-3">
            <legend class="fs-6 fw-bold">Como deseja começar?</legend>
            <label class="form-check mb-2"><input class="form-check-input" type="radio" name="modo" value="novo" checked/> <span class="form-check-label">Criar do zero (estrutura-base Blogger)</span></label>
            <label class="form-check"><input class="form-check-input" type="radio" name="modo" value="modelo"/> <span class="form-check-label">Personalizar um nicho existente</span></label>
          </fieldset>
          <div id="nicho-wrapper" class="mb-3" hidden>
            <label for="nichoTema" class="form-label">Nicho de partida</label>
            <select class="form-select" id="nichoTema" name="nichoTema" disabled>
              <% nichos.forEach(function(n) { %>
                <option value="<%= n.id %>" data-aviso="<%= n.aviso || '' %>"><%= n.nome %></option>
              <% }); %>
            </select>
            <p id="nicho-aviso" class="hint mt-1 mb-0"></p>
          </div>
          <div class="mb-3">
            <label for="siteName" class="form-label">Nome do blog</label>
            <input class="form-control" id="siteName" name="siteName" maxlength="60" minlength="2" value="Meu Blog Azul" required/>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-6"><label for="colorPreset">Paleta de cores</label>
              <select id="colorPreset" name="colorPreset" class="form-select">
                <% cores.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id==='tech-blue'?'selected':'' %>><%= c.nome %></option><% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6"><label for="typography">Fonte</label>
              <select id="typography" name="typography" class="form-select">
                <% fontes.forEach(function(f) { %><option value="<%= f.id %>" <%= f.id==='inter'?'selected':'' %>><%= f.nome %></option><% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6"><label for="gridLayout">Postagens na página</label>
              <select id="gridLayout" name="gridLayout" class="form-select">
                <option value="revista" selected>3 colunas no desktop</option>
                <option value="dupla">2 colunas</option>
                <option value="lista">Lista</option>
                <option value="quadrado">Mosaico</option>
                <option value="mural">Mural compacto</option>
                <option value="coluna-unica">Uma coluna</option>
                <option value="zigzag">Zigue-zague</option>
              </select>
            </div>
            <div class="col-12 col-md-6"><label for="sidebarPosition">Barra lateral</label>
              <select id="sidebarPosition" name="sidebarPosition" class="form-select">
                <option value="right" selected>Direita</option>
                <option value="left">Esquerda</option>
                <option value="none">Sem barra lateral</option>
              </select>
            </div>
          </div>
          <div class="mt-4 p-3 rounded-3" style="background:#0b2538">
            <% if (guestMode) { %>
              <p class="small fw-bold mb-1 text-white">Experimente sem cadastro: até <%= gratuitoLimite %> XML por sessão do navegador.</p>
              <p class="hint mb-0">Não precisa criar conta para testar. <a href="/register">Criar conta</a> é opcional e permite acessar limites e recursos de assinante quando disponíveis. Limites técnicos antiabuso também se aplicam.</p>
            <% } else { %>
              <p class="small fw-bold mb-1 text-white">Conta gratuita: <%= gratuitoLimite %> downloads; assinantes ativos têm limite ampliado.</p>
              <p class="hint mb-0"><a href="/dashboard/plano-essencial">Ver plano Essencial</a> · Sem consumo de créditos de IA.</p>
            <% } %>
          </div>
          <div class="d-flex gap-2 flex-wrap mt-3">
            <button type="button" class="btn btn-outline-info flex-fill" id="surpreender-estilo">Surpreenda-me com um estilo</button>
            <button type="button" class="btn btn-outline-secondary flex-fill" id="salvar-escolhas">Salvar escolhas neste dispositivo</button>
          </div>
          <button type="submit" class="btn btn-sl-primary fw-bold w-100 mt-3" id="download-template">2. Gerar e baixar XML</button>
          <a id="download-link" class="btn btn-outline-info fw-bold w-100 mt-2" hidden>O download não começou? Toque aqui para baixar o XML</a>
          <p id="form-message" class="hint mt-2 mb-0" role="status" aria-live="polite">O arquivo será validado antes do download. Não usa IA. A prévia é aproximada.</p>
        </form>
      </div>
    </section>
    <section class="col-12 col-xl-7" aria-label="Prévia aproximada do visual">
      <div class="panel">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
          <div><h2 class="h5 fw-bold text-white mb-1">Prévia do layout</h2><p class="hint mb-0">Simulação visual; não substitui importar o XML no Blogger para validar a renderização real.</p></div>
          <span class="badge rounded-pill border border-info text-info">Sem navegador na VPS</span>
        </div>
        <div class="fake-blog">
          <div class="fake-header"><strong id="preview-title">Meu Blog Azul</strong><div style="font-size:.74rem;opacity:.75">Seu conteúdo começa aqui</div></div>
          <div class="fake-nav">Início&nbsp; · &nbsp;Categorias&nbsp; · &nbsp;Sobre&nbsp; · &nbsp;Contato</div>
          <div class="fake-body" id="fake-body">
            <div class="fake-grid" id="fake-grid">
              <% for(var i=0;i<6;i++){ %><div class="fake-card"><div class="fake-thumb"></div><div class="fake-title">Exemplo de postagem <%= i+1 %></div></div><% } %>
            </div>
            <div class="fake-aside" id="fake-aside"><strong>Barra lateral</strong><hr/>Categorias<br/>Postagens populares<br/>Arquivo do blog</div>
          </div>
          <div class="fake-footer">© Meu Blog · Blogger</div>
        </div>
        <p class="hint mt-3 mb-0">O XML produzido inclui o widget de postagens do Blogger, CSS responsivo e as opções selecionadas.</p>
      </div>
    </section>
  </div>
</main>
<script>
(function() {
  const form=document.getElementById('generator-form');
  const mode=()=>form.querySelector('input[name="modo"]:checked').value;
  const niche=document.getElementById('nichoTema');
  const wrapper=document.getElementById('nicho-wrapper');
  const body=document.getElementById('fake-body');
  const grid=document.getElementById('fake-grid');
  const aside=document.getElementById('fake-aside');
  const palette={ 'tech-blue':'#0ea5e9', 'tech-blue-royal':'#2563eb', 'tech-blue-ice':'#7dd3fc', 'tech-blue-cobalt':'#1d4ed8','tech-blue-midnight':'#1e3a8a' };
  function refresh() {
    const useNiche=mode()==='modelo';
    wrapper.hidden=!useNiche;niche.disabled=!useNiche;
    document.getElementById('nicho-aviso').textContent=useNiche ? (niche.selectedOptions[0].dataset.aviso||'Este nicho utiliza componentes existentes do compilador.') : '';
    document.getElementById('preview-title').textContent=document.getElementById('siteName').value||'Meu blog';
    const side=document.getElementById('sidebarPosition').value;
    body.classList.toggle('no-sidebar',side==='none');
    body.classList.toggle('sidebar-left',side==='left');
    aside.hidden=side==='none';
    const layout=document.getElementById('gridLayout').value;
    grid.style.gridTemplateColumns=layout==='coluna-unica'||layout==='lista'?'1fr':layout==='dupla'?'repeat(2,minmax(0,1fr))':layout==='mural'?'repeat(4,minmax(0,1fr))':'';
    document.querySelector('.fake-header').style.borderBottomColor=palette[document.getElementById('colorPreset').value]||'#0ea5e9';
  }
  form.addEventListener('change',refresh);document.getElementById('siteName').addEventListener('input',refresh);
  const fields=['colorPreset','typography','gridLayout','sidebarPosition'];
  function secureIndex(length){const values=new Uint32Array(1);crypto.getRandomValues(values);return values[0]%length;}
  document.getElementById('surpreender-estilo').addEventListener('click',()=>{
    for(const id of fields){const select=document.getElementById(id);if(select.options.length)select.selectedIndex=secureIndex(select.options.length);}
    refresh();document.getElementById('form-message').textContent='Novo estilo sorteado. Confira a prévia e baixe seu XML.';
  });
  document.getElementById('salvar-escolhas').addEventListener('click',()=>{
    try{const prefs=Object.fromEntries(fields.map(id=>[id,document.getElementById(id).value]));localStorage.setItem('softload-blogger-estilo-v1',JSON.stringify(prefs));document.getElementById('form-message').textContent='Preferências de visual salvas neste navegador.';}
    catch(e){document.getElementById('form-message').textContent='Não foi possível salvar neste navegador. Você ainda pode baixar seu XML.';}
  });
  try{const prefs=JSON.parse(localStorage.getItem('softload-blogger-estilo-v1')||'{}');for(const id of fields){const value=prefs[id];const select=document.getElementById(id);if(typeof value==='string'&&[...select.options].some(o=>o.value===value))select.value=value;}}catch(e){}
  // Com JavaScript, gera em segundo plano e mostra o erro no editor, sem navegar
  // para uma página de texto HTTP 402/403/422/503. Sem JS, o POST HTML continua funcional.
  const downloadButton=document.getElementById('download-template');
  const downloadLink=document.getElementById('download-link');
  const message=document.getElementById('form-message');
  let lastObjectUrl=null;
  function clearPreviousDownload(){
    downloadLink.hidden=true;
    downloadLink.removeAttribute('href');
    downloadLink.removeAttribute('download');
    if(lastObjectUrl){URL.revokeObjectURL(lastObjectUrl);lastObjectUrl=null;}
  }
  form.addEventListener('submit',async function(event){
    if(!window.fetch||!window.URL||!window.URL.createObjectURL)return;
    event.preventDefault();
    clearPreviousDownload();
    downloadButton.disabled=true;
    message.textContent='Gerando e validando o arquivo XML…';
    try{
      const payload=new URLSearchParams(new FormData(form));
      const response=await fetch(form.action,{
        method:'POST',credentials:'same-origin',redirect:'follow',
        headers:{'Content-Type':'application/x-www-form-urlencoded; charset=utf-8','Accept':'application/xml','X-Requested-With':'XMLHttpRequest'},
        body:payload.toString()
      });
      const mime=response.headers.get('content-type')||'';
      if(!response.ok){
        let explanation=(await response.text()).replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim().slice(0,280);
        if(response.status===401||response.status===403)explanation=explanation||'Sua sessão expirou. Reabra o editor e entre novamente, se necessário.';
        if(!explanation||mime.includes('text/html'))explanation='Não foi possível gerar o arquivo. Reabra o editor e tente novamente.';
        throw new Error(explanation);
      }
      if(!/\b(?:application|text)\/xml\b/i.test(mime)){
        throw new Error(response.redirected?'Sua sessão mudou. Atualize esta página e tente novamente.':'O servidor não retornou um XML. Tente novamente.');
      }
      const blob=await response.blob();
      if(blob.size<1000)throw new Error('O XML retornado parece incompleto. Tente novamente.');
      const disposition=response.headers.get('content-disposition')||'';
      const match=disposition.match(/filename="([a-z0-9-]{1,40}\.xml)"/i);
      const filename=match?match[1]:'template-blogger.xml';
      lastObjectUrl=URL.createObjectURL(blob);
      downloadLink.href=lastObjectUrl;
      downloadLink.download=filename;
      downloadLink.hidden=false;
      message.textContent='XML gerado com sucesso. O download deve começar automaticamente. Se não começar, use o botão de download abaixo.';
      downloadLink.click();
    }catch(error){
      message.textContent=(error instanceof Error?error.message:'Falha ao baixar XML. Verifique sua conexão e tente novamente.');
    }finally{
      downloadButton.disabled=false;
    }
  });
  window.addEventListener('pagehide',clearPreviousDownload);
  refresh();
})();
</script>
<%- include('../partials/footer-blogger') %>