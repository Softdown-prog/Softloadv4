<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Softload V4 | Acesse sua conta</title>
    <meta name="description" content="Entre ou crie uma conta na Softload V4 para acessar as ferramentas de inteligência artificial.">
    <meta name="robots" content="noindex, follow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <%# Bootstrap 5.3.3 — vendorizado localmente, ver scripts/vendorAssets.js.
        Só CSS: a navbar/rodapé públicos (PublicNavbar.jsx/PublicFooter.jsx,
        montados por PublicLayout) são componentes React de verdade agora —
        não usam mais data-bs-toggle, então o bundle JS do Bootstrap não é
        necessário aqui. %>
    <link href="/vendor/bootstrap/css/bootstrap.min.css?v=<%= gitSha %>" rel="stylesheet">
    <link href="/css/softload.css?v=<%= gitSha %>" rel="stylesheet">

    <%# Aplica o tema antes do render para evitar flash %>
    <script>
        (function() {
            var dark = localStorage.getItem('sl-dark-mode') !== '0';
            var html = document.documentElement;
            var theme = dark ? 'dark' : 'light';
            html.setAttribute('data-bs-theme', theme);
            html.setAttribute('data-theme', theme);
            if (dark) { html.classList.add('dark'); } else { html.classList.remove('dark'); }
        })();
    </script>
</head>
<body>

<div id="react-root"></div>
<script type="module" src="/dist/assets/main.js?v=<%= gitSha %>"></script>
</body>
</html>
