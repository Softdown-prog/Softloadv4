{
  "name": "softload-blogger",
  "version": "3.0.0",
  "description": "Gerador procedural de templates XML para Blogger",
  "main": "server.js",
  "scripts": {
    "postinstall": "node scripts/vendorAssets.js",
    "verify:vendor": "node scripts/vendorAssets.js --verify",
    "verify:vendor:templates": "node scripts/vendorTemplateRefs.js",
    "build": "node scripts/vendorAssets.js && node scripts/vendorTemplateRefs.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/runTests.js",
    "typecheck": "tsc --project tsconfig.json --noEmit && node scripts/check-typescript-mirrors.js && node scripts/audit-typescript-migration.js",
    "compile:batch": "node scripts/compile-batch.js",
    "compile:batch:pkg": "node scripts/compile-batch.js",
    "test:quality": "node --test src/routes/dashboard_routes/compiler.procedural.integration.test.js",
    "sync:typescript": "node scripts/check-typescript-mirrors.js --write",
    "audit:typescript": "node scripts/audit-typescript-migration.js",
    "test:typescript-clis": "node --test scripts/typescriptCliSmoke.test.js",
    "typecheck:workers": "tsc --project tsconfig.workers.json --noEmit && node scripts/check-typescript-remaining.cjs && node --test scripts/browserWorkers.test.cjs scripts/browserErrorLog.test.cjs scripts/browserSentinel.test.cjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^13.8.0",
    "mercadopago": "^2.12.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "chart.js": "^4.6.1",
    "typescript": "5.9.3"
  }
}
