{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "frontend/services/api.ts",
    "frontend/utils/accessibilityPrefs.ts",
    "frontend/hooks/useFocusTrap.ts",
    "frontend/hooks/useHeroEntrance.ts",
    "frontend/main.tsx",
    "frontend/App.tsx",
    "frontend/layouts/DashboardLayout.tsx",
    "frontend/layouts/AdminLayout.tsx",
    "frontend/layouts/PublicLayout.tsx",
    "frontend/components/Pill.tsx",
    "frontend/types/react-dom-client.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public/dist",
    "agent"
  ]
}
