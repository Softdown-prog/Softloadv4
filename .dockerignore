node_modules
.env
.env.*
.gitignore
.DS_Store
npm-debug.log*
*.local

# Git history does not belong in Docker build context or runtime image.
# The Actions builder injects the exact commit SHA/date as Docker build arguments.
.git

# A imagem de produção recompila o React no stage frontend-build.
# Não reenviar ao contexto Docker o bundle versionado (public/dist):
# COPY --from=frontend-build fornece o bundle novo ao stage final.
/public/dist/
