{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": [],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/capabilities/**/*.ts", "src/core/*.ts", "src/protocol/*.ts", "src/config/*.ts", "src/notifications/*.ts", "src/security/*.ts", "src/agent.ts", "src/index.ts", "src/server.ts", "src/express-types.d.ts", "src/utils/*.ts"],
  "exclude": ["node_modules"]
}
