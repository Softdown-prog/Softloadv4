{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/utils/envInt.ts",
    "src/utils/logger.ts",
    "src/globals.d.ts",
    "src/serviceMode.ts",
    "src/webSandbox/devices.ts",
    "src/webSandbox/security.ts",
    "src/archive/security.ts",
    "src/webSandbox/console.ts",
    "src/webSandbox/responsive.ts",
    "src/webSandbox/accessibility.ts",
    "src/webSandbox/index.ts",
    "src/archive/index.ts",
    "src/webSandbox/network.ts",
    "src/webSandbox/screenshots.ts",
    "src/webSandbox/browser.ts",
    "src/archive/zipExtractWorker.ts",
    "src/webSandbox/runner.ts",
    "src/server.ts",
    "src/archive/extractArchive.ts",
    "src/archive/extractZip.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
