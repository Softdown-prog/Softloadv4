# Imagem dedicada apenas a extracao ZIP/RAR/7z/TAR.
# O sandbox completo (Chromium) continua sendo construido com Dockerfile.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=0 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    SANDBOX_CHROMIUM_INSTALLED=0 \
    SANDBOX_MODE=archive

WORKDIR /app

# bsdtar/libarchive sao indispensaveis para RAR/7z/TAR;
# nao instale browsers ou pacotes recomendados do Debian.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libarchive-tools ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Mantem o lockfile e as versoes identicas ao sandbox completo.
# npm ci --ignore-scripts impede downloads via postinstall de terceiros.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY src ./src

# Usuario nao-root e dados temporarios somente em /tmp (volumes tmpfs em Compose).
USER node

EXPOSE 8080
CMD ["node", "/app/src/server.js"]
